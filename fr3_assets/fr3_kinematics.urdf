    <limit lower="-2.9007" upper="2.9007" effort="87" velocity="2.6"/>
  </joint>
  <joint name="fr3_joint4" type="revolute">
    <parent link="fr3_link3"/>
    <child link="fr3_link4"/>
    <origin xyz="0.0825 0 0" rpy="1.570796327 -0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.0421" upper="-0.1518" effort="87" velocity="2.6"/>
  </joint>
  <joint name="fr3_joint5" type="revolute">
    <parent link="fr3_link4"/>
    <child link="fr3_link5"/>
    <origin xyz="-0.0825 0.384 0" rpy="-1.570796327 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8065" upper="2.8065" effort="87" velocity="2.6"/>
  </joint>
  <joint name="fr3_joint6" type="revolute">
    <parent link="fr3_link5"/>
    <child link="fr3_link6"/>
    <origin xyz="0 0 0" rpy="1.570796327 -0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.5445" upper="4.5169" effort="87" velocity="2.6"/>
  </joint>
  <joint name="fr3_joint7" type="revolute">
    <parent link="fr3_link6"/>
    <child link="fr3_link7"/>
    <origin xyz="0.088 0 0" rpy="1.570796327 -0 0"/>
    <axis xyz="0 0 1"/>
