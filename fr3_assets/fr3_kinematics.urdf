<?xml version="1.0"?>
<!-- Kinematic chain of fr3.xml for ManiSkill end-effector IK controllers; no geometry or dynamics. -->
<robot name="fr3">
  <link name="fr3_link0"/>
  <link name="fr3_link1"/>
  <link name="fr3_link2"/>
  <link name="fr3_link3"/>
  <link name="fr3_link4"/>
  <link name="fr3_link5"/>
  <link name="fr3_link6"/>
  <link name="fr3_link7"/>
  <link name="fr3_hand"/>
  <link name="fr3_hand_tcp"/>
  <joint name="fr3_joint1" type="revolute">
    <parent link="fr3_link0"/>
    <child link="fr3_link1"/>
    <origin xyz="0 0 0.333" rpy="0 -0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.7437" upper="2.7437" effort="87" velocity="2.6"/>
  </joint>
  <joint name="fr3_joint2" type="revolute">
